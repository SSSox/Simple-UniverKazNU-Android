# Editor defaults matching the repository (.gitattributes keeps LF; Kotlin uses four-space indentation).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

# Test documents are byte-exact fixtures.
[{app/src/test/resources/documents/**,app/src/androidTest/assets/documents/**,app/src/androidTest/assets/site-jquery.js}]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
