<resources>
    <style name="Theme.UniverKazNUSimple" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_surface</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowBackground">@color/md_background</item>
        <item name="bottomSheetDialogTheme">@style/Univer.BottomSheet</item>
        <item name="materialCardViewStyle">@style/Univer.Card</item>
        <item name="toolbarStyle">@style/Univer.Toolbar</item>
        <item name="snackbarStyle">@style/Univer.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Univer.Snackbar.Text</item>
        <item name="snackbarButtonStyle">@style/Univer.Snackbar.Action</item>
        <item name="popupMenuBackground">@drawable/popup_surface</item>
        <!-- Material's Latin tracking leaves Cyrillic and Kazakh text looking spaced out. -->
        <item name="textAppearanceBodyLarge">@style/Univer.TextAppearance.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/Univer.TextAppearance.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/Univer.TextAppearance.BodySmall</item>
        <item name="textAppearanceTitleMedium">@style/Univer.TextAppearance.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/Univer.TextAppearance.TitleSmall</item>
        <item name="textAppearanceLabelLarge">@style/Univer.TextAppearance.LabelLarge</item>
        <item name="textAppearanceLargePopupMenu">@style/Univer.TextAppearance.BodyLarge</item>
        <item name="textAppearanceSmallPopupMenu">@style/Univer.TextAppearance.BodyLarge</item>
    </style>
    <!-- The viewer sits on the app bar colour, so its window paints that instead of a root background over the default one. -->
    <style name="Theme.UniverKazNUSimple.FileViewer">
        <item name="android:windowBackground">@color/app_bar</item>
    </style>
    <style name="Univer.TextAppearance.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Univer.TextAppearance.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Univer.TextAppearance.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Univer.TextAppearance.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Univer.TextAppearance.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Univer.TextAppearance.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:letterSpacing">0</item>
    </style>
    <!-- The separator between the drawer's groups is a hairline, like the app bar's. -->
    <style name="ThemeOverlay.Univer.Drawer" parent="">
        <item name="android:listDivider">@color/app_bar_line</item>
    </style>
    <style name="Univer.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/Univer.TextAppearance.ToolbarTitle</item>
        <item name="subtitleTextAppearance">@style/Univer.TextAppearance.ToolbarSubtitle</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Univer.TextAppearance.ToolbarTitle" parent="Univer.TextAppearance.TitleMedium">
        <item name="android:textSize">17sp</item>
    </style>
    <style name="Univer.TextAppearance.ToolbarSubtitle" parent="Univer.TextAppearance.BodySmall" />
    <!-- A sheet's title is a screen title: the page's own 20 and the app bar's weight, not Material's light headline. -->
    <style name="Univer.TextAppearance.SheetTitle" parent="Univer.TextAppearance.TitleMedium">
        <item name="android:textSize">20sp</item>
    </style>
    <style name="Univer.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card_surface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="shapeAppearance">@style/Univer.Shape.Large</item>
    </style>
    <!-- A message on the theme's own surface, as the Windows toast: it reads as part of the app. -->
    <style name="Univer.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/card_surface</item>
        <item name="shapeAppearance">@style/Univer.Shape.Large</item>
    </style>
    <style name="Univer.Snackbar.Text" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Univer.Snackbar.Action" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <style name="Univer.Shape.Control" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
    <style name="Univer.Shape.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <!-- A rounded-rectangle filter, as in the Windows app: the choice is a tint and a frame, without a check mark. -->
    <style name="Univer.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">10dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipBackgroundColor">@color/filter_chip_fill</item>
        <item name="chipStrokeColor">@color/filter_chip_line</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
    </style>
    <!-- One choice of a segment: a quiet track holds them, the chosen one is raised. -->
    <style name="Univer.Segment" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/segment_option</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">@color/segment_text</item>
    </style>
    <style name="Univer.RowTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Univer.RowHint" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Univer.SectionTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="Univer.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Univer.BottomSheetStyle</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
    </style>
    <style name="Univer.BottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurfaceContainerLow</item>
        <item name="shapeAppearanceOverlay">@style/Univer.SheetShape</item>
    </style>
    <style name="Univer.SheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
    </style>
</resources>
