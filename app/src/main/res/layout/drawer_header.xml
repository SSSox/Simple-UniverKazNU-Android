<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingTop="20dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:id="@+id/drawer_monogram" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/monogram_background" android:importantForAccessibility="no" android:padding="7dp"
            android:src="@drawable/ic_brand" app:tint="?attr/colorOnPrimary" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/drawer_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/brand_name" android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />
            <TextView android:id="@+id/drawer_university" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/university" android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/drawer_account" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="@drawable/banner_background"
        android:backgroundTint="?attr/colorSurfaceContainerHigh" android:drawablePadding="8dp" android:gravity="center_vertical"
        android:minHeight="32dp" android:paddingHorizontal="12dp" android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant" app:drawableStartCompat="@drawable/status_dot" />
</LinearLayout>
