<?xml version="1.0" encoding="utf-8"?>
<!-- The grade totals last seen, without the network: one card, each course with its control periods. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/last_grades_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:orientation="vertical">
    <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/app_bar" app:liftOnScroll="false">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/last_grades_toolbar"
            android:layout_width="match_parent" android:layout_height="64dp" app:navigationIcon="@drawable/ic_back"
            app:subtitleTextAppearance="?attr/textAppearanceBodySmall" />
    </com.google.android.material.appbar.AppBarLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingHorizontal="12dp" android:paddingTop="8dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView android:id="@+id/last_grades_card" android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardBackgroundColor="@color/card_surface" app:cardCornerRadius="16dp"
                app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                <LinearLayout android:id="@+id/last_grades_list" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/last_grades_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="32dp" android:gravity="center" android:paddingHorizontal="16dp" android:text="@string/last_grades_none"
                android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />
            <TextView android:id="@+id/last_grades_note" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:paddingHorizontal="4dp" android:text="@string/last_grades_note"
                android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
