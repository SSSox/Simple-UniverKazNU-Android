<!-- Scrolls under the document bar: in a short window (landscape, split screen, large text) Retry stays reachable. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/document_error" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="true" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:orientation="vertical" android:paddingHorizontal="32dp" android:paddingVertical="40dp">
        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/icon_circle"
            android:backgroundTint="?attr/colorSecondaryContainer" android:importantForAccessibility="no" android:padding="20dp"
            android:src="@drawable/ic_cloud_off" app:tint="?attr/colorOnSecondaryContainer" />
        <TextView android:id="@+id/document_error_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:accessibilityLiveRegion="polite" android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
        <com.google.android.material.button.MaterialButton android:id="@+id/document_retry" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="24dp" android:minHeight="48dp" app:icon="@drawable/ic_refresh" />
    </LinearLayout>
</ScrollView>
