<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewer_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="?attr/colorSurface" app:liftOnScroll="false">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/viewer_toolbar"
            android:layout_width="match_parent" android:layout_height="56dp"
            app:navigationIcon="@drawable/ic_back" app:menu="@menu/file_viewer" />
        <!-- Find in text: the query, "3 of 12", previous/next match and close. -->
        <LinearLayout android:id="@+id/viewer_find_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="4dp"
            android:paddingBottom="8dp" android:visibility="gone">
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/viewer_find_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" app:boxCornerRadiusBottomEnd="24dp"
                app:boxCornerRadiusBottomStart="24dp" app:boxCornerRadiusTopEnd="24dp" app:boxCornerRadiusTopStart="24dp"
                app:hintEnabled="false" app:startIconDrawable="@drawable/ic_search">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/viewer_find"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionSearch"
                    android:importantForAutofill="no" android:inputType="text" android:maxLength="200" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/viewer_find_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:accessibilityLiveRegion="polite" android:minWidth="48dp" android:gravity="center"
                android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.button.MaterialButton android:id="@+id/viewer_find_previous"
                style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp"
                app:icon="@drawable/ic_arrow_up" />
            <com.google.android.material.button.MaterialButton android:id="@+id/viewer_find_next"
                style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp"
                app:icon="@drawable/ic_arrow_down" />
            <com.google.android.material.button.MaterialButton android:id="@+id/viewer_find_close"
                style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp"
                app:icon="@drawable/ic_close" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <WebView android:id="@+id/viewer_web" android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="invisible" />
        <LinearLayout android:id="@+id/viewer_progress" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:orientation="vertical" android:padding="24dp">
            <com.google.android.material.progressindicator.CircularProgressIndicator android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:indeterminate="true" android:importantForAccessibility="no"
                app:indicatorSize="40dp" app:trackThickness="4dp" />
            <TextView android:id="@+id/viewer_progress_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
        <!-- The zoom for a moment after it changes: 50%, 100%, 250%. -->
        <TextView android:id="@+id/viewer_zoom_level" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="24dp"
            android:background="@drawable/banner_background" android:backgroundTint="?attr/colorSurfaceInverse"
            android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="?attr/colorOnSurfaceInverse"
            android:visibility="gone" />
        <ScrollView android:id="@+id/viewer_message" android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                android:orientation="vertical" android:padding="32dp">
                <ImageView android:id="@+id/viewer_message_icon" android:layout_width="72dp" android:layout_height="72dp"
                    android:background="@drawable/icon_circle" android:backgroundTint="?attr/colorSecondaryContainer"
                    android:importantForAccessibility="no" android:padding="20dp" android:src="@drawable/ic_file"
                    app:tint="?attr/colorOnSecondaryContainer" />
                <TextView android:id="@+id/viewer_message_text" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center"
                    android:maxWidth="480dp" android:accessibilityLiveRegion="polite"
                    android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
                <com.google.android.material.button.MaterialButton android:id="@+id/viewer_open_external"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                    android:minHeight="48dp" app:icon="@drawable/ic_open_in_new" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
