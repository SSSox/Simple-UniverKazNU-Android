<!-- Three settings tabs in one sheet: inflated once per opening and never inside a list, so the view count costs nothing while scrolling. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" tools:ignore="TooManyViews">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="0dp" android:paddingBottom="16dp">
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView android:id="@+id/handle"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <FrameLayout android:id="@+id/brand_badge" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:layout_marginBottom="20dp">
            <include layout="@layout/view_stage" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/settings"
                android:textAppearance="@style/Univer.TextAppearance.SheetTitle" android:textColor="?attr/colorOnSurface" />
            <com.google.android.material.button.MaterialButton android:id="@+id/close_settings"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/done" />
        </LinearLayout>
        <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/secure_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Three pages, as in the Windows app's settings; the first-run form shows only what signing in needs. -->
        <com.google.android.material.tabs.TabLayout android:id="@+id/settings_tabs" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@android:color/transparent"
            app:tabGravity="fill" app:tabIndicatorFullWidth="false" app:tabMaxWidth="0dp" app:tabMode="fixed" app:tabPaddingEnd="4dp"
            app:tabPaddingStart="4dp" app:tabRippleColor="@null" app:tabTextAppearance="?attr/textAppearanceLabelLarge" />

        <LinearLayout android:id="@+id/tab_account" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
        <com.google.android.material.card.MaterialCardView android:id="@+id/account_card"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:id="@+id/account_summary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/icon_circle" android:backgroundTint="?attr/colorPrimaryContainer"
                        android:importantForAccessibility="no" android:padding="8dp" android:src="@drawable/ic_account"
                        app:tint="?attr/colorOnPrimaryContainer" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="16dp" android:orientation="vertical">
                        <TextView android:id="@+id/account_title" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/account"
                            android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
                        <TextView android:id="@+id/account_status" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/edit_account"
                    style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp"
                    android:text="@string/edit_account" app:icon="@drawable/ic_lock" app:iconGravity="textStart" />
                <LinearLayout android:id="@+id/credentials" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginTop="12dp">
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/login_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="@string/login" app:startIconDrawable="@drawable/ic_account">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/login"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textNoSuggestions"
                            android:singleLine="true" android:saveEnabled="false" android:importantForAutofill="noExcludeDescendants"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/password_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/password"
                        app:startIconDrawable="@drawable/ic_lock" app:endIconMode="password_toggle"
                        app:endIconContentDescription="@string/show_password">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/password"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword"
                            android:singleLine="true" android:saveEnabled="false" android:importantForAutofill="noExcludeDescendants"
                            android:imeOptions="actionDone" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView android:id="@+id/credentials_note" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="@string/password_not_shown" android:visibility="gone"
                        android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                    <TextView android:id="@+id/feedback" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorError" android:visibility="gone" android:accessibilityLiveRegion="polite" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/save"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:layout_marginTop="16dp" android:text="@string/save" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/manual_login"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/manual_login" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:id="@+id/security_section" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/security_label" style="@style/Univer.SectionTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/security_title" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                    <TextView android:id="@+id/security_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:drawablePadding="12dp" android:gravity="center_vertical" android:minHeight="40dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurface"
                        app:drawableStartCompat="@drawable/ic_lock" app:drawableTint="?attr/colorPrimary"
                        android:accessibilityLiveRegion="polite" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/security_pin_action"
                        style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp"
                        android:text="@string/security_pin_set" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/security_pin_disable"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/security_pin_disable" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/security_biometric"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:text="@string/security_biometric" android:textAppearance="?attr/textAppearanceBodyLarge" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- One row: what the action does, and its button at the end. -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/account_actions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
                android:minHeight="64dp" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginEnd="12dp" android:orientation="vertical">
                    <TextView android:id="@+id/logout_title" style="@style/Univer.RowTitle" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/logout" />
                    <TextView android:id="@+id/logout_hint" style="@style/Univer.RowHint" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/logout_hint" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/logout"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="88dp" android:insetBottom="0dp"
                    android:insetTop="0dp" android:text="@string/logout_action" app:cornerRadius="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout android:id="@+id/tab_app" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
        <LinearLayout android:id="@+id/update_section" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/update_label" style="@style/Univer.SectionTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/update_section" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                    <TextView android:id="@+id/update_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurface"
                        android:accessibilityLiveRegion="polite" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/update_install"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:minHeight="48dp" android:text="@string/update_install" app:icon="@drawable/ic_download" app:iconGravity="textStart" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/update_check"
                        style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp"
                        android:text="@string/update_check" app:icon="@drawable/ic_refresh" app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Links to other sites: where they open, and the data the app's link window keeps. -->
        <TextView android:id="@+id/links_label" style="@style/Univer.SectionTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/links_section" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/links_card" android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/external_links"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp"
                        android:text="@string/external_links" android:textAppearance="?attr/textAppearanceBodyLarge" />
                    <TextView android:id="@+id/external_links_hint" style="@style/Univer.RowHint" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/external_links_hint" />
                </LinearLayout>
                <com.google.android.material.divider.MaterialDivider android:id="@+id/link_data_divider" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" app:dividerColor="?attr/colorOutlineVariant" />
                <LinearLayout android:id="@+id/link_data_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal"
                    android:paddingHorizontal="16dp" android:paddingVertical="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="12dp" android:orientation="vertical">
                        <TextView android:id="@+id/link_data_title" style="@style/Univer.RowTitle" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/link_data" />
                        <TextView android:id="@+id/link_data_hint" style="@style/Univer.RowHint" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:text="@string/link_data_hint" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/link_data_clear"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="88dp" android:insetBottom="0dp"
                        android:insetTop="0dp" android:text="@string/link_data_clear" app:cornerRadius="10dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Where the app opens: the site's news (default) or Кабинет. -->
        <TextView android:id="@+id/start_page_label" style="@style/Univer.SectionTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/start_page_section" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/start_page_card" android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/start_page"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:selectionRequired="true" app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/start_news"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:minHeight="48dp" android:paddingHorizontal="4dp" android:text="@string/start_page_news" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/start_bachelor"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:minHeight="48dp" android:paddingHorizontal="4dp" android:text="@string/start_page_bachelor" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <TextView android:id="@+id/start_page_hint" style="@style/Univer.RowHint" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/start_page_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Class reminders from the saved week: off until turned on, then how long before a class. -->
        <TextView android:id="@+id/reminders_label" style="@style/Univer.SectionTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reminders_section" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/reminders_card" android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/class_reminders"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp"
                    android:text="@string/class_reminders" android:textAppearance="?attr/textAppearanceBodyLarge" />
                <TextView android:id="@+id/class_reminders_hint" style="@style/Univer.RowHint" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:text="@string/class_reminders_hint" />
                <TextView android:id="@+id/class_reminders_feedback" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorError" android:visibility="gone" android:accessibilityLiveRegion="polite" />
                <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/reminder_lead"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    app:selectionRequired="true" app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/reminder_lead_5"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:minHeight="48dp" android:paddingHorizontal="4dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/reminder_lead_10"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:minHeight="48dp" android:paddingHorizontal="4dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/reminder_lead_15"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:minHeight="48dp" android:paddingHorizontal="4dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/reminder_lead_30"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:minHeight="48dp" android:paddingHorizontal="4dp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Background grade checks: off until turned on, only while the site's session lasts. -->
        <TextView android:id="@+id/grades_label" style="@style/Univer.SectionTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/grades_section" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/grades_card" android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/grade_alerts"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp"
                    android:text="@string/grade_alerts" android:textAppearance="?attr/textAppearanceBodyLarge" />
                <TextView android:id="@+id/grade_alerts_hint" style="@style/Univer.RowHint" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:text="@string/grade_alerts_hint" />
                <TextView android:id="@+id/grade_alerts_feedback" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorError" android:visibility="gone" android:accessibilityLiveRegion="polite" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/downloads"
            style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:minHeight="48dp"
            android:text="@string/downloads" app:icon="@drawable/ic_downloads" app:iconGravity="textStart" />
        <com.google.android.material.button.MaterialButton android:id="@+id/diagnostics"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" />
        <TextView android:id="@+id/about" style="@style/Univer.RowHint" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginHorizontal="4dp" android:layout_marginTop="12dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tab_view" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/more_options"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp"
            android:text="@string/more_options" app:icon="@drawable/ic_language" app:iconGravity="textStart" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/preferences" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                <TextView android:id="@+id/language_label" style="@style/Univer.RowTitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/language" />
                <TextView android:id="@+id/language_hint" style="@style/Univer.RowHint" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/language_hint" />
                <RadioGroup android:id="@+id/languages" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:background="@drawable/segment_track" android:orientation="horizontal">
                    <RadioButton android:id="@+id/russian" style="@style/Univer.Segment" android:text="@string/language_ru" />
                    <RadioButton android:id="@+id/kazakh" style="@style/Univer.Segment" android:text="@string/language_kk" />
                    <RadioButton android:id="@+id/english" style="@style/Univer.Segment" android:text="@string/language_en" />
                </RadioGroup>
                <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginVertical="12dp" app:dividerColor="?attr/colorOutlineVariant" />
                <TextView android:id="@+id/theme_label" style="@style/Univer.RowTitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/theme" />
                <LinearLayout android:id="@+id/themes" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:baselineAligned="false" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp"
                        android:layout_weight="1" android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView android:id="@+id/theme_system" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:checkable="true" android:clickable="true" android:focusable="true"
                            app:cardCornerRadius="10dp" app:checkedIcon="@drawable/ic_check" app:checkedIconGravity="BOTTOM_END"
                            app:checkedIconMargin="4dp" app:checkedIconSize="20dp" app:checkedIconTint="?attr/colorPrimary"
                            app:strokeColor="@color/theme_frame" app:strokeWidth="1.5dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true"
                                android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/theme_preview_system" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView android:id="@+id/theme_system_label" style="@style/Univer.RowHint" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center"
                            android:importantForAccessibility="no" android:text="@string/theme_system" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="4dp"
                        android:layout_weight="1" android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView android:id="@+id/theme_light" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:checkable="true" android:clickable="true" android:focusable="true"
                            app:cardCornerRadius="10dp" app:checkedIcon="@drawable/ic_check" app:checkedIconGravity="BOTTOM_END"
                            app:checkedIconMargin="4dp" app:checkedIconSize="20dp" app:checkedIconTint="?attr/colorPrimary"
                            app:strokeColor="@color/theme_frame" app:strokeWidth="1.5dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true"
                                android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/theme_preview_light" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView android:id="@+id/theme_light_label" style="@style/Univer.RowHint" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center"
                            android:importantForAccessibility="no" android:text="@string/theme_light" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp"
                        android:layout_weight="1" android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView android:id="@+id/theme_dark" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:checkable="true" android:clickable="true" android:focusable="true"
                            app:cardCornerRadius="10dp" app:checkedIcon="@drawable/ic_check" app:checkedIconGravity="BOTTOM_END"
                            app:checkedIconMargin="4dp" app:checkedIconSize="20dp" app:checkedIconTint="?attr/colorPrimary"
                            app:strokeColor="@color/theme_frame" app:strokeWidth="1.5dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true"
                                android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/theme_preview_dark" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView android:id="@+id/theme_dark_label" style="@style/Univer.RowHint" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center"
                            android:importantForAccessibility="no" android:text="@string/theme_dark" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginVertical="12dp" app:dividerColor="?attr/colorOutlineVariant" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/mobile_layout"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp"
                    android:text="@string/mobile_layout" android:textAppearance="?attr/textAppearanceBodyLarge" android:checked="true" />
                <TextView android:id="@+id/mobile_hint" style="@style/Univer.RowHint" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/mobile_hint" />
                <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginVertical="12dp" app:dividerColor="?attr/colorOutlineVariant" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/text_size_label" style="@style/Univer.RowTitle" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/text_size" />
                    <TextView android:id="@+id/text_size_value" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/text_size"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:stepSize="10" android:value="100" android:valueFrom="60" android:valueTo="160" />
                <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" app:dividerColor="?attr/colorOutlineVariant" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/animations"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp"
                    android:text="@string/animations" android:textAppearance="?attr/textAppearanceBodyLarge" android:checked="true" />
                <TextView android:id="@+id/animations_hint" style="@style/Univer.RowHint" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/animations_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
