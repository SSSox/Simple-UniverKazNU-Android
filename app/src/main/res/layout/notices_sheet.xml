<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="16dp">
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/notices_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/notices"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" android:textColor="?attr/colorOnSurface" />
            <com.google.android.material.button.MaterialButton android:id="@+id/notices_refresh"
                style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp"
                android:contentDescription="@string/notices_refresh" app:icon="@drawable/ic_refresh"
                app:iconTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
        <TextView android:id="@+id/notices_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:accessibilityLiveRegion="polite" android:visibility="gone"
            android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.button.MaterialButton android:id="@+id/notices_read_all"
            style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp"
            android:text="@string/notices_read_all" app:icon="@drawable/ic_check" />
        <LinearLayout android:id="@+id/notices_list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="vertical" />
        <LinearLayout android:id="@+id/notices_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_horizontal" android:orientation="vertical" android:paddingVertical="24dp" android:visibility="gone"
            tools:ignore="UseCompoundDrawables">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/icon_circle"
                android:backgroundTint="?attr/colorSecondaryContainer" android:importantForAccessibility="no"
                android:padding="18dp" android:src="@drawable/ic_notifications" app:tint="?attr/colorOnSecondaryContainer" />
            <TextView android:id="@+id/notices_empty_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:gravity="center" android:text="@string/notices_empty"
                android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
