<?xml version="1.0" encoding="utf-8"?>
<!-- A score chip like the site's: the control period, the grade (and its maximum when not 100), the band's soft ground
     and the score as a bar along the foot (OfflinePanel colours it). -->
<com.univerflow.kaznu.ui.PlateLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:minWidth="68dp" android:orientation="horizontal" android:paddingStart="8dp" android:paddingTop="4dp"
    android:paddingEnd="8dp" android:paddingBottom="7dp" app:plateRadius="8dp">
    <TextView android:id="@+id/score_label" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:maxLines="1" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
    <TextView android:id="@+id/score_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum"
        android:maxLines="1" android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
    <TextView android:id="@+id/score_max" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum" android:maxLines="1" android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />
</com.univerflow.kaznu.ui.PlateLayout>
