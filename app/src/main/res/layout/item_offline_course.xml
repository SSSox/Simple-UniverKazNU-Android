<?xml version="1.0" encoding="utf-8"?>
<!-- One course of the summary: its name beside its score chips, or over them when there are more than two or the phone
     is narrow (OfflinePanel sets the orientation), as the site's list does. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
    android:minHeight="52dp" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="8dp">
    <TextView android:id="@+id/course_name" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:fontFamily="sans-serif-medium" android:textColor="?attr/colorOnSurface"
        android:textSize="15sp" />
    <com.google.android.material.chip.ChipGroup android:id="@+id/course_scores" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="12dp" android:importantForAccessibility="noHideDescendants"
        app:chipSpacingHorizontal="8dp" app:chipSpacingVertical="8dp" />
</LinearLayout>
