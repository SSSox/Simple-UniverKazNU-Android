<?xml version="1.0" encoding="utf-8"?>
<!-- One course: its name over its control periods and grades. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp">
    <TextView android:id="@+id/grade_course" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
    <TextView android:id="@+id/grade_scores" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:fontFeatureSettings="tnum" android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
