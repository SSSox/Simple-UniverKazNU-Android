<?xml version="1.0" encoding="utf-8"?>
<!-- The saved week without the network: days of the current week as chips, then that day's classes in one card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/timetable_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:orientation="vertical">
    <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/app_bar" app:liftOnScroll="false">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/timetable_toolbar"
            android:layout_width="match_parent" android:layout_height="64dp" app:navigationIcon="@drawable/ic_back"
            app:subtitleTextAppearance="?attr/textAppearanceBodySmall" />
    </com.google.android.material.appbar.AppBarLayout>
    <HorizontalScrollView android:id="@+id/timetable_days_scroll" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:clipToPadding="false" android:paddingHorizontal="12dp" android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup android:id="@+id/timetable_days" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:paddingVertical="8dp" app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true" app:singleLine="true" app:singleSelection="true" />
    </HorizontalScrollView>
    <ScrollView android:id="@+id/timetable_scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" android:paddingHorizontal="12dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView android:id="@+id/timetable_card" android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardBackgroundColor="@color/card_surface" app:cardCornerRadius="16dp"
                app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/timetable_day" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:background="?attr/colorSecondaryContainer" android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorPrimary" />
                    <LinearLayout android:id="@+id/timetable_lessons" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical" />
                    <TextView android:id="@+id/timetable_free" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="16dp" android:text="@string/timetable_free_day"
                        android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/timetable_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="32dp" android:gravity="center" android:paddingHorizontal="16dp" android:text="@string/timetable_none"
                android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />
            <TextView android:id="@+id/timetable_note" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:paddingHorizontal="4dp" android:text="@string/timetable_note"
                android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
