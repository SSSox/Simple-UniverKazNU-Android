<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/downloads_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/app_bar" app:liftOnScroll="false">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/downloads_toolbar"
            android:layout_width="match_parent" android:layout_height="56dp"
            app:navigationIcon="@drawable/ic_back" app:menu="@menu/downloads" />
    </com.google.android.material.appbar.AppBarLayout>
    <!-- The query, and once it is typed whether it also looks inside the files' text. -->
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/downloads_search_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginTop="8dp"
        app:boxBackgroundColor="@color/card_surface" app:boxStrokeColor="?attr/colorOutline" app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp"
        app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp"
        app:endIconMode="clear_text" app:hintEnabled="false" app:startIconDrawable="@drawable/ic_search">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/downloads_search"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionSearch"
            android:importantForAutofill="no" android:inputType="text" android:maxLength="200" android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.chip.Chip android:id="@+id/downloads_text_search" style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp" android:visibility="gone" />
    <!-- The course: a big menu of the courses the files came from, each with its count. -->
    <com.google.android.material.button.MaterialButton android:id="@+id/downloads_subject"
        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
        android:layout_height="44dp" android:layout_marginHorizontal="12dp" android:layout_marginTop="8dp"
        android:gravity="start|center_vertical" android:insetBottom="0dp" android:insetTop="0dp" android:maxLines="1"
        android:ellipsize="end" android:paddingHorizontal="12dp" android:textColor="?attr/colorOnSurface"
        android:visibility="gone" app:backgroundTint="@color/card_surface" app:cornerRadius="10dp" app:icon="@drawable/ic_book"
        app:iconGravity="start" app:iconSize="18dp" app:iconTint="?attr/colorOnSurfaceVariant" app:strokeColor="?attr/colorOutlineVariant" />
    <HorizontalScrollView android:id="@+id/downloads_filters_scroll" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:clipToPadding="false" android:paddingHorizontal="12dp" android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup android:id="@+id/downloads_filters"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingTop="4dp" app:chipSpacingHorizontal="6dp" app:selectionRequired="true" app:singleLine="true" app:singleSelection="true" />
    </HorizontalScrollView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="?android:attr/colorBackground">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/downloads_list"
            android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false"
            android:paddingHorizontal="12dp" android:paddingTop="4dp" android:paddingBottom="24dp" />
        <LinearLayout xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseCompoundDrawables"
            android:id="@+id/downloads_empty" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
            android:padding="32dp" android:visibility="gone">
            <ImageView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/icon_circle"
                android:backgroundTint="?attr/colorSecondaryContainer" android:importantForAccessibility="no"
                android:padding="20dp" android:src="@drawable/ic_downloads" app:tint="?attr/colorOnSecondaryContainer" />
            <TextView android:id="@+id/downloads_empty_text" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center"
                android:maxWidth="420dp" android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
            <TextView android:id="@+id/downloads_empty_hint" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center"
                android:maxWidth="420dp" android:visibility="gone"
                android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
