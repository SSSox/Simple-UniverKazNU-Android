<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingHorizontal="24dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/update_progress_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant"
        android:accessibilityLiveRegion="polite" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/update_progress"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:max="100" app:trackCornerRadius="2dp" />
</LinearLayout>
